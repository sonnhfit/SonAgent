# Dockerfile for SonAgent Skill Sandbox
# This image provides an isolated environment for testing skills

FROM python:3.11-slim

LABEL maintainer="SonAgent Team"
LABEL description="Sandbox environment for testing SonAgent skills"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV SANDBOX_MODE=1

WORKDIR /sandbox

# Install basic dependencies that skills might need
RUN pip install --no-cache-dir \
    pydantic>=2.0.0 \
    requests>=2.28.0 \
    python-dateutil>=2.8.0 \
    PyYAML>=6.0

# Create non-root user for security
RUN useradd -m -s /bin/bash -u 1000 sandbox && \
    chown -R sandbox:sandbox /sandbox

# Set resource limits hints (actual limits set by Docker run)
# These are just documentation
LABEL sandbox.memory_limit="256m"
LABEL sandbox.cpu_limit="0.5"
LABEL sandbox.network_disabled="true"

USER sandbox

# Default command
CMD ["python"]
